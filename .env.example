# Ten plik służy TYLKO do lokalnych komend (npm run dry-run / chat-id / test-telegram).
# Na Netlify te same zmienne wpisujesz w panelu: Project configuration -> Environment variables.
# Skopiuj jako .env – nie wrzucaj .env do repozytorium (jest w .gitignore).

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcjonalne (to są wartości domyślne – nie musisz ich ustawiać):
# PLAN_NAME=VPS-2 2027
# PLAN_CODES=
# OVH_SUBSIDIARY=PL
# PRIORITY_DATACENTERS=WAW
# EUROPE_DATACENTERS=WAW,DE,GRA,SBG,RBX,UK
# NON_EUROPE_DATACENTERS=BHS,SGP,SYD
# STORAGE=local
# OS_FAMILY=linux
# NOTIFY_PREORDER=true
# ERROR_ALERT_AFTER=6
# STARTUP_MESSAGE=true
# DRY_RUN=false
